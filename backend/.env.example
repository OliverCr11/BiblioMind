# === Django Production Environment Variables ===

# Generate a strong, secure secret key for production
# Example: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-your-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames (e.g., your Railway domain)
ALLOWED_HOSTS=bibliomind-production.up.railway.app,localhost,127.0.0.1

# PostgreSQL database URL provided by Railway
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://your_user:your_password@your_host:your_port/your_db

# Comma-separated list of allowed frontend origins (e.g., your Vercel URL)
CORS_ALLOWED_ORIGINS=https://bibliomind.vercel.app,http://localhost:5173
